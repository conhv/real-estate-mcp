# Supabase connection for the MCP server (server-side / trusted).
# Copy to .env and fill in. NEVER commit .env.
SUPABASE_URL=https://etmrjxsxwsecvwvexvbq.supabase.co

# Service-role key: the MCP server runs server-side and needs to read all rows (bypass RLS).
# Get it from: Supabase Dashboard > Project Settings > API > service_role key.
# Keep this SECRET. Do not expose to the browser or embed in agent prompts.
SUPABASE_SERVICE_ROLE_KEY=

# Transport for `python -m app` / the entrypoint:
#   stdio  -> local MCP clients / editors (default)
#   http   -> agent deployment (LangGraph connects to the HTTP MCP endpoint)
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Shared secret for HTTP transport. BẮT BUỘC khi server public (vd Render free
# tier không có Private Service). Agent gửi kèm `Authorization: Bearer <token>`.
# Sinh bằng: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Bỏ trống = không auth, chỉ an toàn khi chạy stdio hoặc trong mạng nội bộ.
MCP_AUTH_TOKEN=
